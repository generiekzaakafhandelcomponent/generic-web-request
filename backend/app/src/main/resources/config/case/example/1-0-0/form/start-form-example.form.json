{
    "display": "form",
    "components": [
        {
            "key": "html",
            "type": "htmlelement",
            "input": false,
            "label": "Instructions",
            "content": "Start a new example case. The generic web request plugin notifies the Example API of the besluit.",
            "tableView": false,
            "refreshOnChange": false
        },
        {
            "key": "name",
            "type": "textfield",
            "input": true,
            "label": "Name",
            "tableView": true,
            "applyMaskOn": "change"
        },
        {
            "key": "pv.besluitId",
            "type": "textfield",
            "input": true,
            "label": "Besluit ID",
            "tableView": true,
            "applyMaskOn": "change",
            "validate": {
                "required": true
            }
        },
        {
            "key": "submit",
            "type": "button",
            "input": true,
            "label": "Start",
            "tableView": false,
            "disableOnInvalid": true
        }
    ]
}
